PORT=4000
WEB_ORIGIN=http://localhost:5173
# Local development uses embedded PostgreSQL in .data. Set DATABASE_URL for a PostgreSQL server.
DATABASE_URL=
DATABASE_DIR=.data
COOKIE_SECURE=false
# Set both values to enable real conversational AI. API usage may incur charges.
OPENAI_API_KEY=
OPENAI_MODEL=
AI_DAILY_LIMIT=20
# Optional public OpenStreetMap services. Search is explicit, cached and rate limited.
NOMINATIM_URL=https://nominatim.openstreetmap.org
OVERPASS_URL=https://overpass-api.de/api/interpreter
MAP_USER_AGENT=CheapChef/1.0 (https://github.com/anasajhani/cheap-chef)

# Required only for Docker Compose; choose a strong URL-safe value.
POSTGRES_PASSWORD=
