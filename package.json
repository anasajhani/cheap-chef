{
  "name": "cheap-chef",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node --env-file-if-exists=.env apps/api/src/server.js\" \"vite --config apps/web/vite.config.js\"",
    "build": "vite build --config apps/web/vite.config.js && node scripts/build-worker.mjs",
    "start": "node --env-file-if-exists=.env apps/api/src/server.js",
    "test": "node --test tests/*.test.js",
    "check": "pnpm test && pnpm build"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4.3.3",
    "vite": "^7.1.4"
  },
  "engines": {
    "node": ">=22"
  }
}
